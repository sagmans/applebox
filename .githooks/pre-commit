#!/bin/bash
#
# Pre-commit hook that runs tests before allowing commit
# This ensures no broken code gets committed to the repository
#

set -e

echo "========================================"
echo "Running pre-commit checks..."
echo "========================================"
echo ""

# Color output for better visibility
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# Function to print status
print_status() {
    if [ $1 -eq 0 ]; then
        echo -e "${GREEN}✓ $2 passed${NC}"
    else
        echo -e "${RED}✗ $2 failed${NC}"
    fi
}

# Track overall status
OVERALL_STATUS=0

# Step 1: Build check
echo -e "${YELLOW}Step 1/2: Building project...${NC}"
echo "Running: swift build"
if swift build 2>&1; then
    print_status 0 "Build"
else
    print_status 1 "Build"
    echo ""
    echo -e "${RED}Build failed. Please fix build errors before committing.${NC}"
    exit 1
fi
echo ""

# Step 2: Run tests
echo -e "${YELLOW}Step 2/2: Running tests...${NC}"
echo "Running: swift test"
if swift test 2>&1; then
    print_status 0 "Tests"
else
    print_status 1 "Tests"
    OVERALL_STATUS=1
fi
echo ""

# Final summary
echo "========================================"
if [ $OVERALL_STATUS -eq 0 ]; then
    echo -e "${GREEN}All pre-commit checks passed!${NC}"
    echo "Proceeding with commit..."
else
    echo -e "${RED}Pre-commit checks failed!${NC}"
    echo "Please fix the failing tests before committing."
    echo ""
    echo "To skip this check (not recommended), use:"
    echo "  git commit --no-verify"
fi
echo "========================================"

exit $OVERALL_STATUS
