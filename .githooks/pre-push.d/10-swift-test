#!/bin/sh
# Build and test replace the removed test.yml macOS CI job (billed at 10x),
# run against each pushed commit, not just HEAD.
set -eu
# shellcheck disable=SC1090,SC1091  # path exported by .githooks/lib/run-local.sh
. "${HOOK_HELPERS:?run from .githooks (scripts/setup-hooks)}"

# AppleBox builds only with the macOS SDK (AppKit, Xcode Swift toolchain).
# Build and test are required before code leaves the machine: on another
# host the push fails with a clear reason instead of a skip.
# (darwin_only from HOOK_HELPERS would skip with exit 0, so it is not used.)
REQUIRED_OS='Darwin'
CHECK_NAME='pre-push swift build/test'

host_os=$(uname -s)
if [ "$host_os" != "$REQUIRED_OS" ]; then
	echo "❌ $CHECK_NAME: needs macOS (uname=$host_os); push from a Mac" >&2
	exit 1
fi

# for loop, not `| while`: a failure must exit this script (fail closed).
shas=$(pushed_shas <"$HOOK_STDIN_FILE") || exit 1
shas=$(printf '%s\n' "$shas" | sort -u)
# shellcheck disable=SC2086  # one SHA per word
for sha in $shas; do
	echo "pre-push: swift build + test at $(git rev-parse --short "$sha")"
	at_sha "$sha" sh -c 'swift build && swift test' || exit 1
done
